{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "internal-rag": {
      "type": "local",
      "command": ["python", ".agents/skills/internal-rag/irag.py", "mcp"],
      "enabled": true
    }
  },
  "notes": "Single-project. Use the router below for multiple projects.",
  "router": {
    "internal-rag-router": {
      "type": "local",
      "command": [
        "python",
        ".agents/skills/internal-rag/irag_mcp_router.py",
        "--registry",
        "examples/projects.example.json"
      ],
      "enabled": true
    }
  }
}
